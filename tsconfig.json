{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./src/*"]
    },
    "baseUrl": ".",
    "types": ["jest"],
    "jsx": "react-jsx"
  },
  "include": ["src/**/*", "__tests__/**/*", "*.ts", "*.tsx"],
  "exclude": ["node_modules"]
}
